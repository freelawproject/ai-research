# Environment variables the app reads (all optional — the defaults run
# the bundled data out of the box). Set them in the shell or in docker
# compose. Neither the pipeline nor the viewer needs an API key; the one
# exception in the repo is the Mistral runner, which keeps its own env
# at runpod/mistral/.env.example.
#
# Where the data folder lives (default: ./data at the repo root).
DATA_ROOT=
# Standard Django settings (extraction/settings/django.py). The
# defaults are for the local walkthrough viewer only.
SECRET_KEY=
DEBUG=
ALLOWED_HOSTS=
